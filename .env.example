# Copy to .env.local for local development. Never commit .env.local.

# Production site URL. Used to build canonical URLs, Open Graph URLs, and
# structured-data @id values. See src/data/site/business.ts.
NEXT_PUBLIC_SITE_URL=https://ultimatefleetgps.net

# External forms endpoint. Static export forbids server routes, so
# CommercialInquiryForm, InstallerNetworkForm, and ApplicationForm POST
# directly to this trusted backend endpoint: the forms Worker in
# workers/forms, which relays each submission to GoHighLevel. See
# workers/forms/README.md. If this is absent, malformed, or the endpoint
# request fails, the forms show an accessible inline error and a
# click-to-call fallback instead of a false success state. No secrets, API
# keys, tokens, or credentials belong in this file or in NEXT_PUBLIC_*
# variables. The GHL token and config are Worker secrets only.
NEXT_PUBLIC_FORMS_ENDPOINT=
