# Dependencies
node_modules/

# Build output
.next/
out/

# Test coverage (root-only: an unanchored "coverage/" also matched and
# silently hid the real src/app/coverage/ route directory - anchor it)
/coverage/

# Environment and secrets
.env
.env.local
.env.*.local

# Generated GHL config (IDs for the forms Worker). Never commit.
ghl-config.generated.json

# Cloudflare
.wrangler/
.dev.vars

# Logs
*.log

# OS and editor
.DS_Store
Thumbs.db
.vscode/*.local.json

# TypeScript build artifacts (generated)
*.tsbuildinfo
next-env.d.ts

# Generated SEO pipeline outputs (regenerate with the route scanner).
# Keyword CSV inputs under docs/seo/keyword-exports/ are not ignored.
docs/seo/*.json
