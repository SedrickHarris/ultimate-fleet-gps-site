# Build domain only. Keep hostname-scoped: never add a bare /* rule, because this
# file applies to every host serving the build, including ultimatefleetgps.net.
# Both rules are permanent. The production pages.dev rule stays as a fallback:
# the dashboard Bulk Redirect to the live domain takes precedence while active.
# See docs/17-cloudflare-deployment.md, section "pages.dev indexing", and
# docs/decisions/0017-telematics-label-and-single-host-indexing.md.
https://ultimate-fleet-gps-site.pages.dev/*
  X-Robots-Tag: noindex

https://:version.ultimate-fleet-gps-site.pages.dev/*
  X-Robots-Tag: noindex
