# Build domain only. Keep hostname-scoped: never add a bare /* rule, because this
# file applies to every host serving the build, including ultimatefleetgps.net.
# At launch, remove the production pages.dev rule and add the dashboard 301.
# See docs/17-cloudflare-deployment.md, section "pages.dev indexing".
https://ultimate-fleet-gps-site.pages.dev/*
  X-Robots-Tag: noindex

https://:version.ultimate-fleet-gps-site.pages.dev/*
  X-Robots-Tag: noindex
