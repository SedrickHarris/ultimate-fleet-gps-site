{
  "name": "ultimate-fleet-gps-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p workers/forms",
    "test:forms": "node --test \"workers/forms/test/*.test.*\"",
    "validate:links": "node scripts/validation/check-internal-links.mjs",
    "validate:output": "node scripts/validation/check-build-output.mjs",
    "postbuild": "npm run validate:output"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  }
}
